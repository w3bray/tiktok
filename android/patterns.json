{
  "_comment": [
    "Padroes (regex, sem distincao de maiusculas) casados contra o content-desc",
    "e o text de cada view do app. Cobrem portugues e ingles.",
    "O TikTok muda esses rotulos entre versoes: rode `npm run android:inspect`",
    "para ver os textos do SEU aparelho e sobrescreva em android/patterns.local.json."
  ],

  "packages": [
    "com.zhiliaoapp.musically",
    "com.ss.android.ugc.trill",
    "com.ss.android.ugc.aweme"
  ],

  "profileTab": ["^perfil$", "^profile$", "^eu$", "^me$", "aba perfil", "profile tab"],
  "likedTab": ["curtid", "\\bliked\\b", "videos curtidos", "liked videos"],
  "repostTab": ["repost", "republicad", "repostagem"],
  "favoritesTab": ["favorito", "^salvos$", "\\bsaved\\b", "\\bfavorites\\b"],
  "collectionsTab": ["^colecoes$", "^colecao$", "^collections$", "minhas colecoes"],

  "likeButton": ["curtir", "curtid", "\\blike\\b", "\\bliked\\b", "descurtir", "unlike"],
  "repostButton": ["^repostar$", "^repost$", "repostado", "reposted"],
  "bookmarkButton": ["favorito", "salvar", "\\bsave\\b", "\\bsaved\\b", "adicionar aos favoritos"],
  "shareButton": ["compartilhar", "\\bshare\\b", "enviar para"],

  "collectionMenu": ["mais opcoes", "more options", "^editar$", "^edit$", "gerenciar"],
  "deleteCollection": [
    "excluir cole",
    "apagar cole",
    "delete collection",
    "remover cole",
    "excluir pasta"
  ],
  "removeRepost": [
    "remover.*repost",
    "remove.*repost",
    "desfazer.*repost",
    "remover.*republica",
    "cancelar.*repost"
  ],
  "confirm": [
    "^remover$",
    "^remove$",
    "^excluir$",
    "^apagar$",
    "^delete$",
    "^confirmar$",
    "^confirm$",
    "^sim$",
    "^yes$",
    "^ok$"
  ],

  "emptyState": [
    "nada por aqui",
    "nenhum video",
    "sem videos",
    "no videos",
    "nothing here",
    "no content"
  ],

  "playerMarker": ["comentar", "\\bcomment", "curtir video", "like video", "descurtir video"]
}
