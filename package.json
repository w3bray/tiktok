{
  "name": "tiktok-cleaner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot que remove 100% dos videos republicados e curtidos da sua propria conta do TikTok",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "clean": "node src/index.js --all",
    "likes": "node src/index.js --likes",
    "reposts": "node src/index.js --reposts",
    "dry-run": "node src/index.js --all --dry-run",
    "login": "node src/index.js --login-only",
    "inspect": "node src/index.js --inspect",
    "android": "node android/src/index.js --all",
    "android:likes": "node android/src/index.js --likes",
    "android:reposts": "node android/src/index.js --reposts",
    "android:dry-run": "node android/src/index.js --all --dry-run",
    "android:inspect": "node android/src/index.js --inspect",
    "test": "npm run test:android && npm run test:userscript && npm run test:web",
    "test:web": "node test/offline.test.mjs",
    "test:userscript": "node test/userscript.test.mjs",
    "test:android": "node test/android.test.mjs && node test/android-adb.test.mjs && node test/android-flow.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.49.1"
  }
}
