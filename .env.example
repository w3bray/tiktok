# Copie este arquivo para .env e preencha com os seus dados.
#   cp .env.example .env
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado.

# Seu @ sem a arroba. Ex.: gutooo777
TIKTOK_USERNAME=

# Login: pode ser o @, o e-mail ou o telefone cadastrado na conta.
TIKTOK_LOGIN=

# Senha da conta. Deixe VAZIO para digitar manualmente na janela do navegador
# (recomendado: assim a senha nao fica em disco).
TIKTOK_PASSWORD=

# Milissegundos entre uma acao e outra (com variacao aleatoria).
# Valores baixos aumentam a chance de captcha / bloqueio temporario.
ACTION_DELAY_MIN=1800
ACTION_DELAY_MAX=4200

# Pausa longa (ms) a cada N acoes, para imitar comportamento humano.
COOLDOWN_EVERY=25
COOLDOWN_MS=45000
